# Artitux (LD_PRELOAD runtime for Artifact releases, Lumice fork of LinUwUx):
# one derivation builds both artefacts upstream's installer ships — the
# lib/Artitux.so library and the bin/artitux launcher wrapper for it.
#
# Artitux.so is built through cargo xtask exactly as upstream does: cargo
# compiles the runtime to a static archive, xtask links it with the export
# version-script and hardening flags and then verifies the ELF itself
# (exports, RELRO/BIND_NOW/NODELETE, constructor order) — nothing overridden.
#
# bin/artitux is generated by the upstream install.sh, not copied here: the
# builder runs it with a pinned ARTITUX_VERSION and a local curl shim on
# PATH that answers its only curl call (with a pinned version it is a plain
# file write) with the just-built .so.
{
  lib,
  stdenv,
  fetchFromGitHub,
  rustPlatform,
  cargo,
  rustc,
  coreutils,
}:
let
  v = (lib.importJSON ../versions.json).artitux;
in
stdenv.mkDerivation {
  pname = "artitux";
  version = v.version;

  # Keep the upstream #!/bin/sh shebang: the fixup-patched store-bash
  # interpreter fails to start inside the steam runtime containers.
  dontPatchShebangs = true;

  src = fetchFromGitHub {
    owner = v.owner;
    repo = v.repo;
    rev = v.rev;
    hash = v.hash;
  };

  # No extra hash to maintain
  cargoDeps = rustPlatform.importCargoLock {
    lockFile = ./artitux-cargo.lock;
  };

  nativeBuildInputs = [
    rustPlatform.cargoSetupHook
    cargo
    rustc
  ];

  buildPhase = ''
    runHook preBuild
    cargo xtask build --output Artitux.so
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    install -Dm644 Artitux.so -t $out/lib/

    # Generate the launcher with the upstream install.sh: pin the version,
    # answer its single "download" from the just-built library, then point
    # the generated script at the store path.
    mkdir -p shim artitux-home
    cat > shim/curl <<'SHIM'
    #!${stdenv.shell}
    out=
    prev=
    for arg in "$@"; do
      if [ "$prev" = "-o" ]; then out=$arg; fi
      prev=$arg
    done
    if [ -z "$out" ]; then
      echo "artitux: curl shim did not see -o FILE (install.sh changed?)" >&2
      exit 2
    fi
    cp "$ARTITUX_SHIM_LIB" "$out"
    SHIM
    chmod +x shim/curl
    export ARTITUX_SHIM_LIB=$PWD/Artitux.so
    export ARTITUX_VERSION=${v.tag}
    export HOME=$PWD/artitux-home
    export PATH=$PWD/shim:$PATH
    bash install.sh
    substituteInPlace artitux-home/.local/bin/artitux \
      --replace-fail "lib='$HOME/.local/share/artitux/Artitux.so'" \
      "lib='$out/lib/Artitux.so'" \
      --replace-fail "/bin/true" "${coreutils}/bin/true"
    install -Dm755 artitux-home/.local/bin/artitux -t $out/bin/
    runHook postInstall
  '';

  meta = {
    description = "LD_PRELOAD runtime for Artifact releases: Artitux.so plus its launcher";
    homepage = "https://github.com/${v.owner}/${v.repo}";
    license = lib.licenses.agpl3Only;
    maintainers = [ lib.maintainers.ataraxiasjel ];
    platforms = [ "x86_64-linux" ];
    mainProgram = "artitux";
  };
}
